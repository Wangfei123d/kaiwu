# npm 缓存默认落在 %LOCALAPPDATA%,受限环境下会 EPERM,重定向到工作区
cache=D:/project/.npm-cache

# 这里不要写 electron_mirror:npm 不认这个键,每次调用都会警告
# `Unknown project config "electron_mirror"`;而本项目是用
# `node node_modules/electron/install.js` 手动装二进制的,那不是 npm 生命周期脚本,
# @electron/get 取不到 npm_config_electron_mirror。请改用环境变量 ELECTRON_MIRROR(见 README)。
